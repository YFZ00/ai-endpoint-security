#!/usr/bin/env bash

set -euo pipefail

ACTION="${1:-}"

CONFIG="/etc/ssh/sshd_config.d/00-ai-endpoint-security.conf"
BACKUP="/etc/ssh/sshd_config.d/00-ai-endpoint-security.conf.bak"


backup_config() {
    if [ -f "$CONFIG" ]; then
        cp -a "$CONFIG" "$BACKUP"
    else
        touch "$CONFIG"
        chmod 0644 "$CONFIG"
        chown root:root "$CONFIG"
    fi
}


validate_and_reload() {
    if /usr/sbin/sshd -t; then
        systemctl reload ssh
        return 0
    fi

    echo "[ERROR] SSH configuration validation failed."

    if [ -f "$BACKUP" ]; then
        cp -a "$BACKUP" "$CONFIG"
        echo "[ROLLBACK] Previous configuration restored."
    fi

    exit 1
}


case "$ACTION" in

    disable-root-ssh-login)

        echo "[INFO] Applying remediation: disable root SSH login"

        backup_config

        if grep -qE '^[[:space:]]*PermitRootLogin[[:space:]]+' "$CONFIG"; then
            sed -i \
                's/^[[:space:]]*PermitRootLogin[[:space:]].*/PermitRootLogin no/' \
                "$CONFIG"
        else
            printf '\nPermitRootLogin no\n' >> "$CONFIG"
        fi

        validate_and_reload

        echo "[SUCCESS] Root SSH login disabled."
        ;;


    limit-ssh-auth-tries)

        echo "[INFO] Applying remediation: limit SSH authentication attempts"

        backup_config

        if grep -qE '^[[:space:]]*MaxAuthTries[[:space:]]+' "$CONFIG"; then
            sed -i \
                's/^[[:space:]]*MaxAuthTries[[:space:]].*/MaxAuthTries 4/' \
                "$CONFIG"
        else
            printf '\nMaxAuthTries 4\n' >> "$CONFIG"
        fi

        validate_and_reload

        echo "[SUCCESS] MaxAuthTries set to 4."
        ;;


    secure-passwd-file)

        echo "[INFO] Applying remediation: secure /etc/passwd"

        chown root:root /etc/passwd
        chmod 0644 /etc/passwd

        CURRENT="$(stat -c '%U:%G %a' /etc/passwd)"

        if [ "$CURRENT" = "root:root 644" ]; then
            echo "[SUCCESS] /etc/passwd ownership and permissions secured."
        else
            echo "[ERROR] /etc/passwd verification failed: $CURRENT"
            exit 1
        fi
        ;;


    *)

        echo "[ERROR] Unsupported remediation action: $ACTION"
        exit 2
        ;;

esac